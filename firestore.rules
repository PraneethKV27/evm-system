rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Voter records – each document ID is the 12-digit Aadhaar number
    match /VoterDB/{aadhaar} {
      allow read, write: if true;
    }

    // Party vote counters – one document per party (AB, CD, EF, GH, NOTA)
    match /PartyDB/{party} {
      allow read, write: if true;
    }

    // Catch-all to deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
